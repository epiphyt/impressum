{
	"name": "epiphyt/impressum",
	"description": "Simple Imprint Generator",
	"type": "wordpress-plugin",
	"homepage": "https://epiph.yt/en/",
	"license": "GPL-2.0-only",
	"require": {
		"php": "^5.6|^7.0|^8.0"
	},
	"support": {
		"email": "hey.composer@epiph.yt",
		"docs": "https://impressum.plus/en/documentation/"
	},
	"authors": [
		{
			"name": "Matthias Kittsteiner",
			"email": "matze.composer@epiph.yt",
			"homepage": "https://kittsteiner.blog",
			"role": "Developer"
		}
	],
	"require-dev": {
		"brain/monkey": "2.*",
		"brain/faker": "dev-master",
		"phpunit/phpunit": "^12.1",
		"epiphyt/coding-standard": "^1.0"
	},
	"autoload": {
		"classmap": ["inc"]
	},
	"scripts": {
		"phpcs": "phpcs -s .",
		"phpstan": "phpstan analyse -v --memory-limit=2G",
		"phpunit": "phpunit --process-isolation",
		"test": [
			"@phpcs",
			"@phpstan",
			"@phpunit"
		]
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
