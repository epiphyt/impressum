{
	"name": "epiphyt/impressum",
	"description": "Simple Imprint Generator",
	"type": "wordpress-plugin",
	"homepage": "https://epiph.yt/en/",
	"license": "GPL-2.0-only",
	"require": {
		"php": "^8.1"
	},
	"support": {
		"email": "hey.composer@epiph.yt",
		"docs": "https://impressum.plus/en/documentation/"
	},
	"authors": [
		{
			"name": "Matthias Kittsteiner",
			"email": "matze.composer@epiph.yt",
			"homepage": "https://kittsteiner.blog",
			"role": "Developer"
		}
	],
	"require-dev": {
		"brain/monkey": "2.*",
		"brain/faker": "dev-master",
		"phpunit/phpunit": "^12.5.45",
		"epiphyt/coding-standard": "^1.2",
		"phpstan/phpstan": "^2.3.7",
		"szepeviktor/phpstan-wordpress": "^2.0.4",
		"phpstan/extension-installer": "^1.4.3",
		"swissspidy/phpstan-no-private": "^1.0",
		"phpstan/phpstan-deprecation-rules": "^2.0.6"
	},
	"autoload": {
		"classmap": ["inc"]
	},
	"scripts": {
		"phpcs": "phpcs -s .",
		"phpstan": "phpstan analyse -v --memory-limit=2G",
		"phpunit": "phpunit",
		"test": [
			"@phpcs",
			"@phpstan",
			"@phpunit"
		]
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpstan/extension-installer": true
		}
	}
}
